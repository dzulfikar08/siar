# Required. Generate both with: bun src/index.ts keygen
SIAR_VAULT_KEY=
SIAR_API_TOKEN=

# Where `siar serve` is reachable from the internet (OAuth callbacks, local media URLs).
SIAR_PUBLIC_URL=https://siar.example.com
SIAR_PORT=8787
# Shown on /, /privacy and /terms. Meta, Google and LinkedIn reviewers read these pages.
SIAR_OPERATOR="Example Company Ltd"
SIAR_OPERATOR_LOCATION=Indonesia
SIAR_CONTACT=privacy@example.com
# SIAR_HOST=127.0.0.1          # put a reverse proxy (Caddy) in front
# SIAR_DATA_DIR=./data
# SIAR_SCHEDULER=off           # set on the stdio process when `serve` runs the scheduler
# SIAR_ENGAGE_MS=120000        # how often comments/DMs are polled for accounts with automations
# SIAR_COMMENT_SYNC=all        # also keep the comment inbox fresh for accounts without automations

# Meta webhooks (optional; makes Instagram DM automations instant and enables follow-gate buttons).
# Callback URL: $SIAR_PUBLIC_URL/webhooks/meta, verify token below. Signatures are checked with the app secret.
SIAR_META_VERIFY_TOKEN=

# Cloudflare R2 media staging (optional; needed for Instagram/Threads/TikTok photos unless SIAR_PUBLIC_URL is public)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://media.example.com

# OAuth apps. Redirect URI for each: $SIAR_PUBLIC_URL/oauth/<platform>/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Company pages: a separate app with only the Community Management API product
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=           # Meta app id: Instagram API with Unified Login (no Facebook Page needed)
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CONFIG_ID=           # Facebook Login for Business configuration id (Instagram use case → API setup)
# INSTAGRAM_LOGIN_CLIENT_ID=   # only for older apps that still have "Instagram Login" (platform instagram-login)
# INSTAGRAM_LOGIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=            # Facebook Pages, and Instagram through a Page (instagram-facebook)
FACEBOOK_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
TIKTOK_CLIENT_ID=              # TikTok client key
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=              # YouTube and Google Business Profile
GOOGLE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# API version pins
# SIAR_LINKEDIN_VERSION=202610
# SIAR_GRAPH_VERSION=v24.0
# SIAR_IG_VERSION=v24.0
