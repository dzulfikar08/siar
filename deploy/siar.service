[Unit]
Description=siar social media scheduler (MCP server)
After=network-online.target
Wants=network-online.target

[Service]
User=siar
Group=siar
WorkingDirectory=/opt/siar/data
EnvironmentFile=/opt/siar/.env
Environment=SIAR_DATA_DIR=/opt/siar/data
ExecStart=/opt/siar/bin/siar serve
Restart=always
RestartSec=3
# Let a publish in flight finish before a stop.
TimeoutStopSec=60
MemoryMax=400M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/siar/data

[Install]
WantedBy=multi-user.target
